{
  "name": "timelens-vscode-extension",
  "displayName": "TimeLens",
  "description": "Track VS Code session time and send local analytics to TimeLens desktop app.",
  "icon": "icons/icon.png",
  "version": "0.4.0",
  "publisher": "ShanWenxiao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PythonSmall-Q/TimeLens.git"
  },
  "homepage": "https://github.com/PythonSmall-Q/TimeLens",
  "bugs": {
    "url": "https://github.com/PythonSmall-Q/TimeLens/issues"
  },
  "keywords": [
    "timetracking",
    "productivity",
    "focus",
    "analytics"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "timelens",
          "title": "TimeLens",
          "icon": "icons/activitybar.svg"
        }
      ]
    },
    "views": {
      "timelens": [
        {
          "id": "timelens.homeView",
          "name": "%timelens.homeView.name%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "timelens.openSidebar",
        "title": "TimeLens: Open Sidebar"
      },
      {
        "command": "timelens.enableTracking",
        "title": "TimeLens: Enable Tracking"
      },
      {
        "command": "timelens.disableTracking",
        "title": "TimeLens: Disable Tracking"
      },
      {
        "command": "timelens.showStatus",
        "title": "TimeLens: Show Tracking Status"
      },
      {
        "command": "timelens.setTrackingLevel",
        "title": "TimeLens: Set Detail Level"
      },
      {
        "command": "timelens.setExtensionBridgeKey",
        "title": "TimeLens: Set/Update Extension Bridge Key"
      },
      {
        "command": "timelens.openDashboard",
        "title": "TimeLens: Open Dashboard",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "timelens.openDashboard",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "TimeLens",
      "properties": {
        "timelens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%timelens.enabled.description%"
        },
        "timelens.apiBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:49152",
          "description": "%timelens.apiBaseUrl.description%"
        },
        "timelens.apiBaseUrlCacheSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 3600,
          "description": "%timelens.apiBaseUrlCacheSeconds.description%"
        },
        "timelens.apiBaseUrlCacheMode": {
          "type": "string",
          "default": "duration",
          "enum": ["duration", "startup"],
          "enumDescriptions": [
            "%timelens.apiBaseUrlCacheMode.duration%",
            "%timelens.apiBaseUrlCacheMode.startup%"
          ],
          "description": "%timelens.apiBaseUrlCacheMode.description%"
        },
        "timelens.bridgeKey": {
          "type": "string",
          "default": "",
          "description": "%timelens.bridgeKey.description%"
        },
        "timelens.apiToken": {
          "type": "string",
          "default": "",
          "description": "%timelens.apiToken.description%"
        },
        "timelens.flushIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 600,
          "description": "%timelens.flushIntervalSeconds.description%"
        },
        "timelens.idleThresholdSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 30,
          "maximum": 1800,
          "description": "%timelens.idleThresholdSeconds.description%"
        },
        "timelens.trackingLevel": {
          "type": "string",
          "enum": ["basic", "standard", "detailed"],
          "enumDescriptions": [
            "%timelens.trackingLevel.basic%",
            "%timelens.trackingLevel.standard%",
            "%timelens.trackingLevel.detailed%"
          ],
          "default": "standard",
          "description": "%timelens.trackingLevel.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "watch": "tsc -w -p ./tsconfig.json",
    "package": "npm run build && npx @vscode/vsce package",
    "package:pre": "npx @vscode/vsce package --pre-release"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2",
    "@types/node": "^20.17.47",
    "@types/vscode": "^1.100.0",
    "typescript": "^5.8.3"
  }
}
